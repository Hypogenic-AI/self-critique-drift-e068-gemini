{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/usr/bin/bash -lc \"source .venv/bin/activate && python - << 'PY'\nfrom datasets import load_from_disk\nimport numpy as np, re\n\ng=load_from_disk('datasets/gsm8k')['test']\nc=load_from_disk('datasets/commonsense_qa')['validation']\n\n# missing\nmg=sum(1 for r in g if (not r['question']) or (not r['answer']))\nmc=sum(1 for r in c if (not r['question']) or (not r.get('answerKey','')))\nprint('gsm_missing',mg,'of',len(g))\nprint('csqa_missing',mc,'of',len(c))\n\n# duplicates by question\ngq=[r['question'].strip() for r in g]\ncq=[r['question'].strip() for r in c]\nprint('gsm_dup',len(gq)-len(set(gq)))\nprint('csqa_dup',len(cq)-len(set(cq)))\n\n# lengths\nlg=[len(r['question']) for r in g]\nlc=[len(r['question']) for r in c]\nprint('gsm_len_mean',round(float(np.mean(lg)),2),'std',round(float(np.std(lg)),2))\nprint('csqa_len_mean',round(float(np.mean(lc)),2),'std',round(float(np.std(lc)),2))\n\n# csqa class dist\nfrom collections import Counter\ncc=Counter([r['answerKey'] for r in c])\nprint('csqa_class',dict(cc))\n\n# gsm answer numeric parse success\nok=0\nfor r in g:\n    if re.search(r'####\\\\s*([-+]?\\\\d[\\\\d,\\\\.]*)', r['answer']):\n        ok+=1\nprint('gsm_parseable',ok,'of',len(g))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
