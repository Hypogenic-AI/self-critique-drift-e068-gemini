{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/usr/bin/bash -lc \"source .venv/bin/activate && python - << 'PY'\nimport json, pandas as pd, numpy as np\nfrom pathlib import Path\n\nm1=json.load(open('results/metrics_Qwen_Qwen2.5-1.5B-Instruct.json'))\nm0=json.load(open('results/metrics_Qwen_Qwen2.5-0.5B-Instruct.json'))\raw1=pd.read_json('results/raw_Qwen_Qwen2.5-1.5B-Instruct.jsonl', lines=True)\nraw0=pd.read_json('results/raw_Qwen_Qwen2.5-0.5B-Instruct.jsonl', lines=True)\n\nprint('M1 accuracy', {k:round(v['mean'],3) for k,v in m1['accuracy'].items()})\nprint('M0 accuracy', {k:round(v['mean'],3) for k,v in m0['accuracy'].items()})\n\nfor name,raw in [('1.5B',raw1),('0.5B',raw0)]:\n    print('\\\\nDataset breakdown',name)\n    for ds,g in raw.groupby('dataset'):\n        print(ds,len(g),\n              'direct',round(g['direct_correct'].mean(),3),\n              'self1',round(g['self1_correct'].mean(),3),\n              'self3',round(g['self3_correct'].mean(),3),\n              'external',round(g['external_correct'].mean(),3))\n\nlast1=str(max(m1['layers_selected']))\nprint('\\\\nM1 last layer',last1,'drift means', {c:round(m1['drift'][c][last1]['mean'],4) for c in m1['drift']})\nprint('M1 step drift last layer', {r:round(v[last1],4) for r,v in m1['step_drift'].items()})\n\n# probe change (post-pre) on last layer\nfor label,m in [('1.5B',m1),('0.5B',m0)]:\n    last=str(max(m['layers_selected']))\n    print('\\\\nProbe delta AUC',label)\n    for c in ['rewrite_control','self_critique_1','self_critique_3','external_critique']:\n        pre=m['probe'][c]['pre'][last]['auc']\n        post=m['probe'][c]['post'][last]['auc']\n        if pre==pre and post==post:\n            print(c, round(post-pre,4), 'pre',round(pre,4),'post',round(post,4))\n        else:\n            print(c, 'nan')\n\nc=json.load(open('results/metrics_combined.json'))\nprint('\\\\nOpenAI',c['openai_behavioral'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
